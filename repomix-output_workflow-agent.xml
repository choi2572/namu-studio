# Example workflow-agent llama-server layout (copy and set WORKFLOW_AGENT_MODELS_CONFIG).
# Paths can be relative to this YAML file.

llama_server_executable: llama-server
host: 127.0.0.1

startup_timeout_seconds: 90
shutdown_timeout_seconds: 15
healthcheck_timeout_seconds: 5
health_poll_interval_seconds: 0.5
# After the TCP port is open, keep GET /health until 2xx (503 during GPU load is retried).
