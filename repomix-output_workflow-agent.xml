]

[project.scripts]
workflow-agent = "workflow_agent.main:run"

[tool.setuptools.packages.find]
where = ["src"]

# --- Ruff: formatter + linter (run: ruff format . && ruff check .) ---
[tool.ruff]
target-version = "py310"
line-length = 120
src = ["src"]
exclude = [
    ".venv",
    "venv",
    "__pycache__",
