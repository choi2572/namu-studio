        """List all workflows."""
        conn = get_db()
        cursor = conn.execute("""
            SELECT workflow_id, name, description, state,
                   current_published_version_id, created_at, updated_at
            FROM workflows
            ORDER BY created_at DESC
        """)
        workflows = []
