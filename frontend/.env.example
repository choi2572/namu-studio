# Mock API 사용 여부
# true: Mock API 어댑터 사용 (백엔드 없이 개발 가능)
# false 또는 미설정: 실제 HTTP API 어댑터 사용 (백엔드 필요)
NEXT_PUBLIC_USE_MOCK_API=false

# 백엔드 API Base URL
# USE_MOCK_API=false일 때 사용됩니다.
# 기본값: http://localhost:5000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# VLM 모니터링 (기본 OFF) — docs/vlm_monitoring.md
# 설정 후 dev 서버 재시작 필요. 또는 브라우저에서 localStorage.setItem('ENABLE_VLM_NODES','true') 후 새로고침으로 테스트 가능.
# NEXT_PUBLIC_ENABLE_DYNAMIC_GRAPH_PATCH=false
# NEXT_PUBLIC_ENABLE_VLM_NODES=false
