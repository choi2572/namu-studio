    debug = _run_service.get_node_debug(run_id, state_name)
    if not debug:
        return jsonify(
            {
                "runId": run_id,
                "stateName": state_name,
                "nodeName": state_name,
                "status": None,
                "durationMs": None,
                "input": None,
                "output": None,
                "feedback": None,
