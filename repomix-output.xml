    """Get run events."""
    after_seq = request.args.get("afterSeq")
    after_seq_int = int(after_seq) if after_seq else None

    events = _run_service.get_events(run_id, after_seq_int)

    return jsonify(events)


@bp.route("/<run_id>/resume", methods=["POST"])
