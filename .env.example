# docker compose env (optional). Copy to .env and adjust.
# Backend
# SECRET_KEY=your-secret-key
# SEED_DATA=false
# REPO_BACKEND=inmemory
# DB_PATH=./data/app.db
# EXECUTION_ENGINE=dummy
# MIDDLEWARE_BASE_URL=http://localhost:8000

# Uncomment in docker-compose.yml to run mock middleware in backend container:
# backend.environment.RUN_MOCK_MIDDLEWARE=1
